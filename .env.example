# ccms-gateway — the single browser entry point
PORT=8080
IDENTITY_URL=http://127.0.0.1:3001
LOGS_URL=http://127.0.0.1:3002
CATALOGUE_URL=http://127.0.0.1:3003
CALENDAR_URL=http://127.0.0.1:3003

# Deployed environments: HTTPS only. Plain-HTTP GET/HEAD is redirected (308), other methods are refused.
# REQUIRE_TLS defaults to true when NODE_ENV=production.
# REQUIRE_TLS=true
# Behind a TLS-terminating load balancer that sends X-Forwarded-Proto:
# TRUST_PROXY=true
# Or terminate TLS in the gateway itself:
# TLS_CERT_FILE=/etc/ccms/tls/cert.pem
# TLS_KEY_FILE=/etc/ccms/tls/key.pem

# Token check on non-public /api routes. Defaults: keys from IDENTITY_URL/api/auth/jwks, issuer ccms-identity, audience ccms.
# IDENTITY_JWKS_URL=http://127.0.0.1:3001/api/auth/jwks
# JWT_ISSUER=ccms-identity
# JWT_AUDIENCE=ccms
# VERIFY_TOKENS=false
