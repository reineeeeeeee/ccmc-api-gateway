# ccms-api-gateway — copy to .env.local.
# Where each service runs (origin only, no /api). Catalogue and Calendar are both in Core.
IDENTITY_URL=http://127.0.0.1:3001
CORE_URL=http://127.0.0.1:3003
LOGS_URL=http://127.0.0.1:3002

# Token check on every non-public /api route. Keys come from IDENTITY_URL/api/auth/jwks by default.
# IDENTITY_JWKS_URL=http://127.0.0.1:3001/api/auth/jwks
# JWT_ISSUER=ccms-identity
# JWT_AUDIENCE=ccms
# VERIFY_TOKENS=false

# HTTPS only: on by default on Vercel (VERCEL=1), off for a local `npm start`. Force it with REQUIRE_TLS=true.
# TRUST_PROXY=true makes the gateway believe X-Forwarded-Proto (Vercel sets it).
# REQUIRE_TLS=true
# TRUST_PROXY=true

# How long to wait for a service before answering 504 (seconds).
# PROXY_TIMEOUT_SECONDS=25
